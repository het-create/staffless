# STAFFLESS runs in simulation mode by default — no key needed, nothing below
# this line is required to run the demo.
PORT=8788

# Optional: set USE_GEMINI=true to route agent calls through the real Gemini
# API instead of the local simulator. If a live call fails for any reason
# (bad key, quota, network), STAFFLESS automatically falls back to the
# simulator so a demo never breaks mid-run.
USE_GEMINI=false
GEMINI_API_KEY=your-key-here
GEMINI_MODEL=gemini-3.5-flash-lite
